#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        colon_semicolon: colon_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMICOLON";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        capsword {
            bindings = <&caps_word>;
            key-positions = <46 59>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp NUMBER_1    &kp NUMBER_2      &kp NUMBER_3  &kp NUMBER_4   &kp N5  &kp NUMBER_6                                                    &kp N7                     &kp N8  &kp N9          &kp N0         &kp MINUS          &kp EQUAL        &kp BACKSPACE
&kp TAB           &kp Q           &kp W             &kp E         &kp R          &kp T   &none                                                           &none                      &kp Y   &kp U           &kp I          &kp O              &kp P            &kp BSLH
&kp LEFT_CONTROL  &kp A           &kp S             &kp D         &kp F          &kp G   &kp GRAVE     &sk LEFT_SHIFT  &none       &none   &sl 1         &kp RS(RA(RC(RIGHT_GUI)))  &kp H   &kp J           &kp K          &kp L              &kp SEMICOLON    &kp SQT
&kp LSHFT         &kp Z           &kp X             &kp C         &kp V          &kp B                                 &none       &none                                            &kp N   &kp M           &kp COMMA      &kp DOT            &kp FSLH         &kp RSHFT
&mo 2             &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_META          &kp LEFT_GUI  &mo 1           &tog 1      &tog 2  &lt 1 RETURN  &kp SPACE                          &kp RIGHT_META  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp ESCAPE  &none   &none      &none      &none      &none            &trans                                        &mo 3      &none      &none                 &none                  &none          &kp EQUAL         &kp MINUS
&kp TAB     &none   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_ENTER     &none                                         &none      &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &none          &none             &kp BSLH
&trans      &none   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_NUMBER_0  &trans    &none  &none      &none  &none      &trans     &kp GRAVE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN  &kp GREATER_THAN  &kp SQT
&kp LSHFT   &none   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp PERIOD                        &none      &none                        &kp MINUS  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &none             &kp RSHFT
&mo 2       &trans  &trans     &trans     &trans                      &kp BSPC  &none  &to 0      &to 0  &kp ENTER  &kp SPACE             &trans                &trans                 &trans         &trans            &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3          &kp F4          &kp F5           &kp F6          &tog 1                                      &mo 3   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F12
&trans  &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP    &none                                       &none   &trans                &trans                &trans      &trans             &trans           &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT              &kp DOWN              &kp UP      &kp RIGHT          &trans           &trans
&trans  &trans  &trans          &trans          &trans           &trans                          &trans      &trans                  &trans                &trans                &trans      &trans             &trans           &trans
&trans  &trans  &trans          &trans          &trans                           &trans  &trans  &trans      &trans  &trans  &trans                        &trans                &trans      &trans             &trans           &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
