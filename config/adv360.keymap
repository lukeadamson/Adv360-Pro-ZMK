#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        colon_semicolon: colon_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMICOLON";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        thumb_mod: thumb_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <50>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        hyper_c {
            bindings = <&macro_hyper_c>;
            key-positions = <32 31>;
            timeout-ms = <20>;
        };

        hyper_s {
            bindings = <&macro_hyper_s>;
            key-positions = <30 31>;
            timeout-ms = <20>;
        };

        left_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <41 42>;
            timeout-ms = <20>;
        };

        right_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <42 43>;
            timeout-ms = <20>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <23 24>;
            timeout-ms = <15>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <24 25>;
            timeout-ms = <15>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <55 56>;
            timeout-ms = <20>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <56 57>;
            timeout-ms = <20>;
        };

        arrow {
            bindings = <&macro_arrow>;
            key-positions = <12 13>;
            timeout-ms = <20>;
        };

        cut {
            bindings = <&kp LG(X)>;
            key-positions = <47 48>;
            timeout-ms = <15>;
            layers = <6>;
        };

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <48 49>;
            timeout-ms = <15>;
            layers = <6>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <49 50>;
            timeout-ms = <15>;
            layers = <6>;
        };

        system_layer {
            bindings = <&tog 3>;
            key-positions = <60 75>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <11 12>;
            timeout-ms = <20>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <25 26>;
            timeout-ms = <20>;
        };

        hyper_m {
            bindings = <&kp LS(LA(LC(LG(M))))>;
            key-positions = <32 30>;
        };
    };

    macros {
        macro_hyper_c: macro_hyper_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(LG(C))))>;
            label = "MACRO_HYPER_C";
        };

        macro_hyper_s: macro_hyper_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(LG(S))))>;
            label = "MACRO_HYPER_S";
        };

        macro_arrow: macro_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "MACRO_ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp NUMBER_1    &kp NUMBER_2      &kp NUMBER_3  &kp NUMBER_4  &kp N5  &none                                                       &none                      &kp NUMBER_6  &kp N7          &kp N8         &kp N9             &kp N0           &kp BACKSPACE
&kp TAB           &kp Q           &kp W             &kp E         &kp R         &kp T   &none                                                       &none                      &kp Y         &kp U           &kp I          &kp O              &kp P            &kp BSLH
&kp LEFT_CONTROL  &kp A           &kp S             &kp D         &kp F         &kp G   &kp GRAVE     &none         &none      &none  &mo 2         &kp RS(RA(RC(RIGHT_GUI)))  &kp H         &kp J           &kp K          &kp L              &kp SEMICOLON    &kp SQT
&kp LSHFT         &kp Z           &kp X             &kp C         &kp V         &kp B                               &none      &none                                           &kp N         &kp M           &kp COMMA      &kp DOT            &kp FSLH         &kp EQUAL
&none             &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI          &kp LEFT_GUI  &kp LEFT_ALT  &none      &none  &lt 2 RETURN  &kp SPACE                                &kp RIGHT_META  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &tog 3
            >;
        };

        colemak {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &kp Q   &kp W   &kp F   &kp P   &kp B   &trans                                      &trans  &kp J   &kp L   &kp U   &kp Y   &kp SEMI  &trans
&trans  &kp A   &kp R   &kp S   &kp T   &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp M   &kp N   &kp E   &kp I   &kp O     &trans
&trans  &kp X   &kp C   &kp D   &kp V   &kp Z                   &trans      &trans                  &kp K   &kp H   &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans    &trans
            >;
        };

        nav {
            display-name = "navigation";
            bindings = <
&trans  &kp F1     &kp F2           &kp F3           &kp F4           &kp F6        &kp F6                                           &kp F7  &kp F8  &kp F9          &kp F10          &kp F11    &kp F12  &trans
&trans  &trans     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans        &trans                                           &trans  &trans  &trans          &kp UP_ARROW     &trans     &trans   &trans
&trans  &kp KP_N0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ENTER  &trans  &trans  &trans      &bootloader  &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT  &trans   &trans
&trans  &trans     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans                        &trans      &trans                       &trans  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans     &trans   &trans
&trans  &trans     &trans           &trans           &trans                         &trans  &trans  &trans      &trans       &trans  &trans          &trans          &trans           &trans     &trans   &trans
            >;
        };

        sys {
            display-name = "system";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &kp C_VOLUME_UP
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &kp C_VOL_DN
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &kp K_MUTE
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &trans
            >;
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
