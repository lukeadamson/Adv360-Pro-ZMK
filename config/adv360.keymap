#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        timeless_hrm_right: timeless_hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "TIMELESS_HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <20>;
            require-prior-idle-ms = <150>;
            flavor = "tap-unless-interrupted";
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67 37 38 53 68 69 70>;
            hold-trigger-on-release;
        };

        colon_semicolon: colon_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMICOLON";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        timeless_hrm_left: timeless_hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "TIMELESS_HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <20>;
            require-prior-idle-ms = <150>;
            flavor = "tap-unless-interrupted";
            hold-trigger-key-positions = <35 36 52 65 66 67 37 38 53 68 69 70 7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        capsword {
            bindings = <&caps_word>;
            key-positions = <46 59>;
        };
    };

    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp LEFT_ALT &kp LEFT_CONTROL &kp LEFT_GUI>;
            label = "HYPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp EXCL        &kp AT            &kp HASH      &kp DOLLAR     &kp PERCENT  &tog 1                                                                   &mo 3      &kp CARET  &kp AMPS        &kp STAR       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&kp TAB           &kp Q           &kp W             &kp E         &kp R          &kp T        &none                                                                    &none      &kp Y      &kp U           &kp I          &kp O                 &kp P                  &kp BSLH
&kp LEFT_CONTROL  &kp A           &kp S             &kp D         &kp F          &kp G        &hyper         &none  &none               &none            &none         &hyper     &kp H      &kp J           &kp K          &kp L                 &colon_semicolon       &kp SQT
&kp LSHFT         &kp Z           &kp X             &kp C         &kp V          &kp B                              &none               &none                                     &kp N      &kp M           &kp COMMA      &kp DOT               &kp FSLH               &kp RSHFT
&mo 2             &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_META               &kp BACKSPACE  &mo 1  &kp LEFT_SHIFT      &kp RIGHT_SHIFT  &lt 1 RETURN  &kp SPACE             &kp RIGHT_META  &kp RIGHT_ALT  &kp RIGHT_CONTROL     &kp RIGHT_SHIFT        &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &none   &none      &none      &none      &none            &trans                                        &mo 3      &none      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none   &kp EQUAL  &kp MINUS
&kp TAB    &none   &kp KP_N7  &kp KP_N8  &kp KP_N9  &none            &none                                         &none      &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &none   &none      &kp BSLH
&kp ESC    &none   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_NUMBER_0  &trans    &none  &none      &none  &none      &trans     &kp GRAVE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none   &none      &kp SQT
&kp LSHFT  &none   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp PERIOD                        &none      &none                        &none      &kp LESS_THAN         &kp GREATER_THAN       &trans  &none      &kp RSHFT
&mo 2      &trans  &trans     &trans     &trans                      &kp BSPC  &none  &none      &none  &kp ENTER  &kp KP_N0             &trans                &trans                 &trans  &trans     &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3          &kp F4          &kp F5           &kp F6  &tog 1                                      &mo 3   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F12
&trans  &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans  &none                                       &none   &trans                &trans                &trans      &trans             &trans           &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT              &kp DOWN              &kp UP      &kp RIGHT          &trans           &trans
&trans  &trans  &trans          &trans          &trans           &trans                  &trans      &trans                  &trans                &trans                &trans      &trans             &trans           &trans
&trans  &trans  &trans          &trans          &trans                   &trans  &trans  &trans      &trans  &trans  &trans                        &trans                &trans      &trans             &trans           &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
